FROM node:20-alpine

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем файлы конфигурации зависимостей
COPY package*.json ./

# Устанавливаем все библиотеки фронтенда
RUN npm install

# Копируем весь остальной код фронтенда
COPY . .

# дефолтный порт Vite
EXPOSE 5173

# Запускаем фронтенд с флагом --host, чтобы он был доступен вне контейнера
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]